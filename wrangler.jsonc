{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "custom-worker.ts",
  "name": "hyfin",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "hyfin" }],
  // Deposit scanner: every 5 minutes.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Public, non-secret settings. Secrets (SUPABASE_SECRET_KEY, CRON_SECRET) are set in the dashboard.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://hyfin.io",
    "NEXT_PUBLIC_SUPABASE_URL": "https://kpsiuvayjzpgjlkylmcc.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtwc2l1dmF5anpwZ2psa3lsbWNjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTYwNjM1ODQsImV4cCI6MjA3MTYzOTU4NH0.MDcmLvGU6FyFYSn_Y8BcgYomXkF3CtR4Hl-3p-iSFcM"
  },
  // Keep variables added in the dashboard when a new version deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
