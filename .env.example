# Copy to .env.local and fill in. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project settings > API keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key, or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses row level security. Never expose to the browser.
# Secret key, or the legacy "service_role" key.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Deposits ---
# Extended PUBLIC key at m/44'/60'/0'/0 from your treasury hardware wallet.
# The server derives one deposit address per subscription from it and cannot move funds.
DEPOSIT_XPUB=xpub...
# A network is offered to investors only if its RPC URL is set.
RPC_BASE=
RPC_ARBITRUM=
RPC_ETHEREUM=
# Scanner tuning. Lower SCAN_BLOCK_CHUNK if your RPC plan limits eth_getLogs ranges.
SCAN_BLOCK_CHUNK=2000
SCAN_MAX_CHUNKS=20
SCAN_INITIAL_LOOKBACK=5000
# Unpaid reservations are released after this many hours.
RESERVATION_HOURS=48

# --- Cron ---
# Long random string. /api/cron/scan requires "Authorization: Bearer <this>".
CRON_SECRET=

# --- Who may invest (set with your lawyer) ---
BLOCKED_COUNTRIES=EG,KP,IR,SY,CU
ACCREDITED_ONLY_COUNTRIES=US

# --- Alerts (all optional) ---
RESEND_API_KEY=
EMAIL_FROM=HyFin <deals@yourdomain.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@yourchannel
DISCORD_WEBHOOK_URL=
